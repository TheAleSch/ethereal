{
  "name": "@theale/ethereal",
  "version": "0.1.0",
  "description": "Travelling-light and black-hole glow effects for React \u2014 pure CSS gradients and masks driven by one shared animation loop.",
  "keywords": [
    "react",
    "glow",
    "border-beam",
    "animation",
    "css-effects",
    "button",
    "ethereal"
  ],
  "author": "Alexandre Schrammel",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://ethereal.ale.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAleSch/ethereal.git",
    "directory": "packages/ethereal"
  },
  "bugs": {
    "url": "https://github.com/TheAleSch/ethereal/issues"
  }
}
